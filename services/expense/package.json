    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.21.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
