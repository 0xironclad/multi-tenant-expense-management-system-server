# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Per-service database URLs (used by each service's drizzle config)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db
USER_ORG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_org_db
EXPENSE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_db
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_db
FILE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── MinIO (local S3) ────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=receipts
AWS_REGION=eu-central-1

# ─── Auth service ─────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ─── Queue driver ─────────────────────────────────────────────────────────────
# "rabbitmq" for local dev, "sqs" for production
QUEUE_DRIVER=rabbitmq

# ─── AWS (production only) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_EXPENSE_EVENTS_URL=
SQS_NOTIFICATION_JOBS_URL=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
